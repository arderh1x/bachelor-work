{
  "compilerOptions": {
    /* Path Aliases */
    "paths": {
      "@shared/*": ["../shared/*"],
      "@/*": ["./src/*"]
    },

    /* File Layout */
    "rootDir": "..", 
    "outDir": "./dist",
    "rootDirs": ["./src", "../shared"],

    /* Environment Settings */
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],

    /* Other Outputs */
    "sourceMap": true,
    "declaration": true,
    "declarationMap": true,

    /* Stricter Typechecking Options */
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,

    /* Style & Recommended Options */
    "jsx": "react-jsx",
    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "noUncheckedSideEffectImports": true,
    "moduleDetection": "force",
    "skipLibCheck": true
  },
  
  "include": ["src/**/*", "../shared/**/*"]
}